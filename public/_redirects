# Public tool + pricing routes get their OWN prerendered shell (self-referencing
# canonical), so Google does not treat them as duplicates of the landing page.
# These MUST come before the /sq/* and /* catch-alls below — Netlify uses the
# first match. The files are emitted at build time by prerenderToolRoutesPlugin
# (vite.config.js). All are exact paths, so order among them does not matter, only
# that they all precede the catch-alls.
/tools                             /tools.html                              200
/pricing                           /pricing.html                            200
/tools/salary-calculator           /tools/salary-calculator.html            200
/tools/self-employed-calculator    /tools/self-employed-calculator.html     200
/tools/loan-calculator             /tools/loan-calculator.html              200
/sq/tools                          /sq/tools.html                           200
/sq/pricing                        /sq/pricing.html                         200
/sq/tools/salary-calculator        /sq/tools/salary-calculator.html         200
/sq/tools/self-employed-calculator /sq/tools/self-employed-calculator.html  200
/sq/tools/loan-calculator          /sq/tools/loan-calculator.html           200

# /.well-known/* is for machine-readable files (ARD manifest, ai-catalog,
# security.txt...). None exist here, so answer 404 instead of letting the SPA
# catch-all serve index.html with 200: Lighthouse's Agentic Browsing audit
# fetches /.well-known/ard.json, got HTML, and failed with "malformed JSON".
# With a 404 the audit is "not applicable". A real file added later under
# public/.well-known/ is still served (Netlify serves existing files before
# non-forced rules). Must come before the catch-alls below.
/.well-known/*     /index.html     404

# Albanian language shell — must come BEFORE the SPA catch-all
/sq        /sq.html     200
/sq/*      /sq.html     200

# Everything else boots the default (English) shell for client-side routing
/*         /index.html  200
