# Supabase Configuration
# Create a project at https://supabase.com and copy these values from your project settings

VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Paddle Configuration (for subscription payments)
# Get these from your Paddle dashboard at https://vendors.paddle.com

VITE_PADDLE_CLIENT_TOKEN=your_paddle_client_token_here
VITE_PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_YEARLY_PRICE_ID=your_yearly_price_id_here

# E2E Encryption feature flag
# Gates onboarding to client-side encryption (registration auto-setup, the
# AccountPage opt-in card). The decrypt path is always active regardless of
# this flag, so already-encrypted users are unaffected if it's turned off.
VITE_E2EE_ENABLED=false
